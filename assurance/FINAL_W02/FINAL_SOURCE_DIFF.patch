+export type CollectionCellProjection={
+  text:string;
+  secondary?:string;
+  ariaLabel?:string;
+  direction?:CollectionDirection;
+  tone?:CollectionTone;
+};
+
+export type CollectionRowAction={
+  id:string;
+  label:string;
+  enabled?:boolean;
+  destructive?:boolean;
+  ariaLabel?:string;
+};
+
+export type CollectionColumnDescriptor<TRow>={
+  id:string;
+  label:string;
+  width?:string;
+  minWidth?:number;
+  align?:CollectionAlign;
