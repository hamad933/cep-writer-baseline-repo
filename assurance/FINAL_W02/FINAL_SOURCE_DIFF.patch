+export function resolveGlobalShellRoute(search:string|URLSearchParams){
+  const params=typeof search==='string'?new URLSearchParams(search):search;
+  const raw=params.get('surface');
+  const requested=raw===null?'library':raw;
+  if(raw===null)return {requested,surface:'library' as const,kind:'product' as const,fallback:false};
