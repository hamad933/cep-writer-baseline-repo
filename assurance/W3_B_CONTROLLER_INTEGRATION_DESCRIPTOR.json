{
  "schemaVersion": 1,
  "kind": "W3_B_CONTROLLER_INTEGRATION_DESCRIPTOR",
  "status": "READY_FOR_SEQUENTIAL_CONVERGENCE",
  "mission": "W3-B-ACCESSIBILITY-FEEDBACK",
  "owner": "AccessibilityFeedbackOwner",
  "policyRevision": "w3b-accessibility-feedback-v1",
  "sourceModules": [
    "stack/native-typescript/foundation/global/feedback-contract.ts",
    "stack/native-typescript/foundation/global/feedback.ts"
  ],
  "controllerConvergenceOrder": "A input -> B feedback -> C context -> D bottom -> E scale",
  "integrationLaw": {
    "instantiateExactlyOneOwner": true,
    "presentationOnly": true,
    "canonicalTruthRemainsWithSourceOwners": true,
    "focusOwnership": false,
    "transientStackOwnership": false,
    "sharedDomIntegrationInWriter": false
  },
  "projectionInputs": {
    "required": [
      "message",
      "sourceFamily",
      "sourceOwner",
      "sourceTruth"
    ],
    "sourceTruthUse": "validation-only; contradictory source truth is refused before projection; canonical truth is never retained or resolved",
    "supportedOutcomes": [
      "info",
      "success",
      "warning",
      "unavailable",
      "failure",
      "error"
    ],
    "channels": [
      "announcement",
      "status",
      "toast",
      "tooltip"
    ]
  },
  "controllerIntegrationTargets": [
    {
      "path": "stack/native-typescript/foundation/accepted-runtime.ts",
      "existing": [
        "announce",
        "toast"
      ],
      "action": "delegate presentation to the single AccessibilityFeedbackOwner during Controller convergence; preserve underlying command/runtime/save/domain truth owners"
    },
    {
      "path": "stack/native-typescript/foundation/workspace.ts",
      "existing": [
        "foundationStatus aria-live sink"
      ],
      "action": "route generic reusable status presentation through the owner if retained; do not move ContextDescriptor/domain meaning"
    },
    {
      "path": "stack/native-typescript/foundation/spatial.ts",
      "existing": [
        "spatial-readout aria-live"
      ],
      "action": "keep spatial-specific readout semantics domain-local unless Controller explicitly uses owner only as presentation sink; do not transfer spatial truth"
    }
  ],
  "domProjection": {
    "projector": "AccessibilityFeedbackProjector",
    "singleProjectionRootGuard": true,
    "liveRegions": {
      "polite": {
        "role": "status",
        "aria-live": "polite",
        "aria-atomic": "true"
      },
      "assertive": {
        "role": "alert",
        "aria-live": "assertive",
        "aria-atomic": "true"
      }
    },
    "tooltip": {
      "role": "tooltip",
      "live": false
    },
    "focusCalls": 0
  },
  "doNotMove": [
    "Structured error truth",
    "relation truth",
    "runtime/device truth",
    "save/persistence truth",
    "command availability truth",
    "domain status meaning"
  ],
  "evidence": [
    "assurance/W3_B_REAL_CONSUMER_PROOF.json",
    "assurance/W3_B_BROWSER_ACCESSIBILITY_PROOF.json",
    "assurance/W3_B_CENTRAL_POLICY_MODIFICATION_REVERT_PROOF.json",
    "assurance/W3_B_NEGATIVE_PROOF.json",
    "assurance/W3_B_PROTECTED_HOTSPOT_INTEGRITY.json",
    "assurance/W3_B_SOURCE_TRUTH_CONTRADICTION_PROOF.json",
    "assurance/W3_B_CORRECTION_NEGATIVE_BOUNDARY_PROOF.json"
  ],
  "sourceTruthBoundary": {
    "validateBeforeProjection": true,
    "contradictionHandling": "throw/refuse FEEDBACK_SOURCE_TRUTH_CONTRADICTION; do not infer corrected canonical value",
    "presentationIntentMismatch": "refuse with FEEDBACK_TRUTH_CONFLICT",
    "canonicalResolutionOwnedByFeedback": false
  }
}
