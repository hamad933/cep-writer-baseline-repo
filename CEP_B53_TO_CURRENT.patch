+import {createLocalPersistenceClient} from './persistence/local-persistence-client.js';
+import {DomainWorkingStateClient} from './persistence/domain-state-client.js';
+
+export function relatedContextIdentity(record,kind='source'){
+  const ref=record?.canonicalRef||record?.identity||record?.targetRef||record;
+  const objectId=ref?.objectId||ref?.documentId||record?.documentId||record?.target||record?.id;
+  const domain=ref?.sourceDomain||ref?.surfaceId||record?.surfaceId||({source:'library',lab:'labs',evidence:'evidence'}[kind]);
+  return typeof objectId==='string'&&objectId.trim()&&['library','learn','labs','enterprise','evidence'].includes(domain)?{domain,objectId}:null;
+}
+
+/** A label or guessed URL never establishes that an object exists. */
+export async function resolveRelatedContext(record,kind='source',client=createLocalPersistenceClient()){
+  const identity=relatedContextIdentity(record,kind);if(!identity)return {ok:false,code:'RELATED_TARGET_IDENTITY_UNAVAILABLE'};
+  const {domain,objectId}=identity;let available=false,targetId=objectId;
+  if(domain==='library'||domain==='learn'){const read=await client.readDocument(objectId);available=read?.ok===true&&read.document?.id===objectId;}
+  else if(domain==='evidence'){const catalog=await client.request('GET','/v1/evidence-owner/catalog'),row=catalog?.ok===true&&(catalog.evidence||[]).find(row=>row.ref===objectId||row.evidenceId===objectId);available=!!row;targetId=row?.revision?.evidenceId||row?.evidenceId||objectId;}
+  else{const read=await new DomainWorkingStateClient(domain,client).readWorking('current');const payload=read?.payload;available=domain==='labs'?payload?.definition?.id===objectId:!!payload&&(payload.enterpriseId===objectId||(payload.relationState?.nodes||[]).some(row=>row.id===objectId));}
+  if(!available)return {ok:false,code:'RELATED_TARGET_UNAVAILABLE',identity};
+  const url=new URL(location.href);url.search='';url.searchParams.set('surface',domain);url.searchParams.set(domain==='library'||domain==='learn'?'sourceDocumentId':'contextObjectId',targetId);
+  return {ok:true,identity,url:url.href};
+}
