{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CEPSurfaceProfile",
  "type": "object",
  "required": [
    "surface",
    "workspace",
    "foundation",
    "family_engines",
    "slots",
    "domain_commands"
  ],
  "properties": {
    "surface": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "foundation": {
      "type": "object"
    },
    "family_engines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "slots": {
      "type": "object"
    },
    "domain_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_lenses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bottom_tabs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_duplicates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
